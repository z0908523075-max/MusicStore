@model Album

@{
    ViewBag.Title = "專輯 - " + Model.Title;
}

<h2>@Model.Title</h2>

<p>
    <img alt="@Model.Title" src="@Url.Content(@Model.AlbumArtUrl)" />
</p>

<div id="album-details">
    <p>
        <em>流派：</em>
        @Model.Genre.Name
    </p>
    <p>
        <em>演出者：</em>
        @Model.Artist.Name
    </p>
    <p>
        <em>價格：</em>
        <label>@Model.Price</label>
    </p>
    <p class="button">
        <a asp-controller="ShoppingCart" asp-action="AddToCart" asp-route-id="@Model.AlbumId">加入購物車</a>
    </p>
</div>