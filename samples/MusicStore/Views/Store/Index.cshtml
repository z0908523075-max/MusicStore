@model IEnumerable<Genre>
@{
    ViewBag.Title = "商店";
}
<h3>瀏覽音樂流派</h3>

<p>
    從 @Model.Count() 個音樂流派中選擇：
</p>
<ul class="list-group">
    @foreach (var genre in Model)
    {
        <li class="list-group-item"><a asp-controller="Store" asp-action="Browse" asp-route-genre="@genre.Name">@genre.Name</a></li>
    }
</ul>